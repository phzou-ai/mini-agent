# Copy this file to .env for local development. Never commit real credentials,
# private hostnames, or machine-specific key paths.

# Optional remote Kubernetes access used by the example MCP server.
VERMAY_SSH_TARGET=user@example-host
VERMAY_SSH_PORT=22
VERMAY_SSH_IDENTITY_FILE=~/.ssh/id_ed25519
VERMAY_SSH_KNOWN_HOSTS_FILE=~/.ssh/known_hosts

# Optional credentials referenced by config/models.json.
OPENAI_API_KEY=

# Server-side backend URL used by the Next.js BFF.
VERMAY_API_BASE=http://127.0.0.1:8000
